# Copy this file to backend/.env and replace every placeholder.
# Never commit backend/.env. Never put these values in the frontend.

# Supabase Postgres connection string. Use the URI from Project Settings > Database.
# The application rewrites postgresql:// to postgresql+psycopg://.
# Prefer the direct connection (port 5432) for the experiment runner.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Project URL, for example https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy JWT secret from Project Settings > API, used when tokens are signed with HS256.
# Leave blank if your project only uses the newer JWT signing keys (ES256/RS256).
SUPABASE_JWT_SECRET=

# Service role key. Server and seed script only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI-compatible provider. The key stays on the server.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Password used only by scripts/seed.py to create synthetic accounts.
# Choose a unique password of at least 12 characters. It is not a default login.
SEED_USER_PASSWORD=

# Directory for uploaded files. Relative paths are resolved from the backend directory.
STORAGE_DIR=storage/uploads
